"smart_sources:Evaluation/TruLens/TruLens.md": {"class_name":"SmartSource","last_read":{"hash":"msusk2","at":1786494851960},"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":82,"read_hash":"msusk2","at":1786494859563}}},"path":"Evaluation/TruLens/TruLens.md","last_import":{"mtime":1761679343417,"size":8257,"at":1786494852083,"hash":"msusk2"},"outlinks":[{"title":"GitHub Repo stars","target":"https://img.shields.io/github/stars/truera/trulens?style=social\n\n  \n  TruLens evaluates AI agents with feedback functions to measure their performance and minimize risk:\n  \n  * Context Relevance\n  * Groundedness\n  * Answer Relevance\n  * Comprehensiveness\n  * Harmful or toxic language\n  * User sentiment\n  * Language mismatch\n  * Fairness and bias\n  * other custom feedback functions you provide\n \n    Definitions are in https://github.com/truera/trulens/blob/ad4667472df0d15b3f7681a5b521bd4830f94f54/src/feedback/trulens/feedback/llm_provider.py\n\n\n\n    https://www.trulens.org/reference/\n\n    Providers for invoking various models or using them for feedback functions.\n      \n      📦 Cortex in the package trulens-providers-cortex for using Snowflake Cortex models.\n      \n      📦 LangChain in the package trulens-providers-langchain for using models via LangChain.\n      \n      📦 Bedrock in the package trulens-providers-bedrock for using Amazon Bedrock models.\n      \n      📦 HuggingFace and HuggingfaceLocal in the package trulens-providers-huggingface for using HuggingFace models.\n      \n      📦 LiteLLM in the package trulens-providers-litellm for using models via LiteLLM.\n      \n      📦 OpenAI and AzureOpenAI in the package trulens-providers-openai for using OpenAI models.\n\n\n    Take Cortex provider as example:\n\n\n\n    **I. Core Evaluation Metrics (General Purpose","line":2,"embedded":true}],"blocks_data":{"#":{"text":null,"length":0,"last_read":{"hash":"cqd5s1","at":1786494851960},"key":"Evaluation/TruLens/TruLens.md#","lines":[2,144],"size":8244,"should_embed":true,"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":618,"read_hash":"cqd5s1","at":1786494859503}}}},"##{1}":{"text":null,"length":0,"last_read":{"hash":"1tfs9dk","at":1786494851960},"key":"Evaluation/TruLens/TruLens.md##{1}","lines":[2,4],"size":98,"should_embed":false}},"block_embedding_selection":{"version":2,"min_chars":200,"max_input_chars":1894,"source_key":"Evaluation/TruLens/TruLens.md","requires_reimport":false},"task_lines":[],"tasks":{},"codeblock_ranges":[],"outlinks_version":2},
